# Database configuration (PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resumatch

# Application Security & JWT
SECRET_KEY=generate-a-secure-secret-key-for-production
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173

# Redis Distributed Cache & Rate Limiting (Optional - falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# Cloud Storage (AWS S3 / Cloudflare R2 / MinIO - falls back to local disk storage)
S3_BUCKET_NAME=resumatch-resumes
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_ENDPOINT_URL=

# Razorpay Payment Gateway (Optional - falls back to mock mode in development)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI & LLM Rewriter
GEMINI_API_KEY=your-google-gemini-api-key
